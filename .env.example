# Nestora — environment variables
#
# Copy to .env.local for local development. NOTHING in this file is a secret;
# every value below is a placeholder. Never commit a real key.
#
# The application validates these at startup (src/lib/config.ts) and reports any
# production misconfiguration as a single FATAL/WARN block in the server log.

# ─────────────────────────────────────────────────────────── required in production

# Managed PostgreSQL connection string. REQUIRED on Vercel: the serverless
# filesystem is read-only and ephemeral, so the local SQLite fallback cannot
# store data there.
#   Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/rentlink?sslmode=require
#   Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Use the provider's POOLED endpoint (Neon: -pooler host, Supabase: port 6543)
# so lambda concurrency cannot exhaust the database's connection limit.
DATABASE_URL=

# Signs session tokens. REQUIRED in production; 32+ characters.
#   openssl rand -hex 32
# Without it a serverless deployment cannot derive a stable secret and sessions
# are invalidated at random (see src/lib/crypto.ts).
SESSION_SECRET=

# Durable object storage for uploads and private documents. REQUIRED in
# production: without it, uploads go to a read-only filesystem and fail.
# Create a Blob store in the Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/reminders, which Vercel Cron calls on a schedule.
#   openssl rand -hex 24
# Without it the scheduled reminder sweep is disabled (503) rather than exposed.
CRON_SECRET=

# ─────────────────────────────────────────────────────────── danger: do not set
#
# Starts a production process even when the configuration above is unsafe
# (SQLite instead of PostgreSQL, local-disk uploads, demo accounts). It exists
# only so a throwaway local/demo deployment can run; the server logs a warning
# saying it must not be treated as production-ready. NEVER set this on Vercel.
RENTLINK_ALLOW_INSECURE_PROD=

# ─────────────────────────────────────────────────────────── payments (optional)

# Set ALL THREE to accept real payments, or NONE to run in clearly-labelled demo
# mode where no money moves. A partial configuration is reported as fatal.
# Use rzp_test_… keys until a real Razorpay account has been verified.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────── email (optional)

# Without an email provider, notifications are stored in the database and shown
# in-app only. Nothing is emailed.
RESEND_API_KEY=
EMAIL_FROM=

# ─────────────────────────────────────────────────────────── demo data (local only)

# Opt in to seeding fictional demo accounts. NEVER set this on a public
# deployment: every demo account shares one password, including an admin.
ALLOW_DEMO_SEED=
# Overrides the documented demo password (Demo@1234). Set this if you must run a
# demo deployment with ALLOW_DEMO_SEED=1.
DEMO_PASSWORD=

# ─────────────────────────────────────────────────────────── database tuning

# Max connections per lambda instance. Keep small (3–5) and use a pooled
# endpoint; each concurrent lambda opens its own pool.
PGPOOL_MAX=3
# verify-full (default) | require | no-verify | disable
# Keep verify-full in production. The other values exist for local testing and
# for hosts whose certificate chain the runtime does not trust.
PG_SSL_MODE=verify-full
# Skip the cold-start schema bootstrap. Set to 1 in production and run
# `npm run db:pg:migrate` as an explicit deploy step instead.
PG_SKIP_SCHEMA=

# ─────────────────────────────────────────────────────────── local development only

# Path to the SQLite file used when DATABASE_URL is unset.
DATABASE_PATH=
# Base URL for the Razorpay API (tests point this at a local stand-in).
RAZORPAY_API_BASE=
