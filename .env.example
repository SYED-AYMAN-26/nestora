# ---------------------------------------------------------------------------
# RentLink 3D — environment configuration
# Copy to .env.local and fill what you have. Everything is optional:
# the app runs fully in labelled demo mode without any of these.
# ---------------------------------------------------------------------------

# Absolute path to the SQLite database file (persistent storage).
# Defaults to ./data/rentlink.db
DATABASE_PATH=./data/rentlink.db

# Where uploaded images / documents are written. Defaults to ./uploads
UPLOAD_DIR=./uploads

# --- Demo data policy ------------------------------------------------------
# Every seeded account (including an admin) is fictional and shares one
# password. On a production deployment the seeder refuses to run and demo
# logins are refused unless you opt in below.
#   ALLOW_DEMO_SEED=1   acknowledge that demo accounts are live
#   DEMO_PASSWORD=...   seed with a password other than the documented default
ALLOW_DEMO_SEED=
DEMO_PASSWORD=

# Secret used to sign session cookies. A random one is generated into
# data/.session-secret on first boot if this is unset.
SESSION_SECRET=

# --- Razorpay (TEST MODE ONLY) --------------------------------------------
# When both keys are present the payment page creates real Razorpay test
# orders and verifies the returned HMAC signature server-side.
# When absent, the app uses the clearly-labelled DEMO PAYMENT MODE.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Razorpay dashboard -> Webhooks). Used to verify the
# `x-razorpay-signature` header on /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Optional AI provider --------------------------------------------------
# If set, /api/recommend calls the provider for a natural-language intent
# parse; otherwise the transparent rule-based capability engine is used and
# the UI says so explicitly.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Optional outbound notifications --------------------------------------
# Without these, notifications are in-app only and the UI labels email /
# WhatsApp as "not configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RentLink 3D <no-reply@rentlink.example>

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Cloudinary (optional managed uploads) --------------------------------
# Leave blank to store uploads on local disk (default, works out of the box).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
