{
  "name": "rentlink-3d",
  "version": "1.0.0",
  "private": true,
  "description": "RentLink 3D - list unused resources, discover what you need, share safely.",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "start:demo": "ALLOW_DEMO_SEED=1 next start -p 3000 -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-e2e.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "verify:3d": "node scripts/check-3d.mjs",
    "verify:links": "node scripts/check-links.mjs",
    "db:reset": "node scripts/seed.mjs --reset",
    "db:seed": "node scripts/seed.mjs",
    "verify": "node scripts/seed.mjs && node scripts/test-e2e.mjs",
    "verify:full": "node scripts/verify-all.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "db:pg:schema": "node scripts/gen-pg-schema.mjs && node scripts/gen-schema-module.mjs",
    "db:pg:migrate": "node scripts/migrate.mjs",
    "test:db-adapter": "node scripts/test-db-adapter.mjs",
    "prebuild": "node scripts/gen-schema-module.mjs",
    "predev": "node scripts/gen-schema-module.mjs",
    "prestart": "node scripts/gen-schema-module.mjs",
    "preverify": "node scripts/gen-schema-module.mjs",
    "db:migrate:data": "node scripts/migrate-to-postgres.mjs",
    "sweep:pages": "node scripts/sweep-pages.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@vercel/blob": "^2.8.2",
    "better-sqlite3": "11.10.0",
    "next": "^15.5.7",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.28",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
